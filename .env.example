# Docker Compose development settings. Replace every secret before production use.

# Database Configuration
POSTGRES_PASSWORD=appointocare_dev_password
DATABASE_URL=postgresql://postgres:appointocare_dev_password@db:5432/appointocare

# Application Settings
SECRET_KEY=appointocare_dev_secret_change_me
JWT_SECRET_KEY=appointocare_dev_jwt_secret_change_me
APP_ENV=development
CORS_ORIGINS=http://localhost:4200

# Demo Data Seeding (set to false for empty database)
SEED_DEMO_DATA=true

# Demo User Credentials (used when SEED_DEMO_DATA=true)
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=Admin@12345
ORG_USERNAME=org1
ORG_PASSWORD=Org@12345
STAFF_USERNAME=staff1
STAFF_PASSWORD=Staff@12345

# Payment Provider Settings (leave empty to use mock provider)
PAYMENT_PROVIDER=mock
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Provider Settings (leave empty to use mock provider)
WHATSAPP_PROVIDER=mock
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Email Provider Settings (leave empty to use mock provider)
EMAIL_ENABLED=false
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=AppointoCare

# SMS Provider Settings (leave empty to use mock provider)
SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=

# Feature Flags
REMINDERS_ENABLED=true
